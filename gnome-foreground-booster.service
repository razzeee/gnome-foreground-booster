[Unit]
Description=Device-memory protection for the focused application in GNOME
PartOf=graphical-session.target
After=dmemcg-booster-user.service

[Service]
Type=dbus
BusName=org.gnome.ForegroundBooster
Slice=background.slice
ExecStart=/usr/bin/gnome-foreground-booster
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
